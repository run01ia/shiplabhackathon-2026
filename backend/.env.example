# コピーして backend/.env を作り、値を入れる。.env はコミットしない。
# ローカルの Supabase (supabase start) を使う場合は、起動時に表示される値を貼る。
SUPABASE_URL=http://127.0.0.1:54321
# 公開してよいキー (publishable / anon)
SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。絶対に front へ渡さない・コミットしない (service_role / secret)
SUPABASE_SECRET_KEY=
# Claude API (レシート AI 判定、REQ-012)。サーバー専用。絶対に front へ渡さない・コミットしない。
# 空のままなら機能は無効になり、画面に「レシートを読む」が出ない (アプリは動く)。
ANTHROPIC_API_KEY=
# レシートの読み取りの、全ユーザー合計の 1 日上限 (コスト対策)。空なら 200
RECEIPT_DAILY_GLOBAL_LIMIT=
# DB ありのローカル確認用。memory にすると、Claude API を呼ばず固定の読み取り結果を返す。
# NODE_ENV=development を明示したときだけ効く (未設定・production では無視される)
RECEIPT_READER=
# 画面の URL の許可リスト (カンマ区切り)。未設定なら http://localhost:5173
CORS_ORIGINS=
