# コピーして backend/.env を作り、値を入れる。.env はコミットしない。
# ローカルの Supabase (supabase start) を使う場合は、起動時に表示される値を貼る。
SUPABASE_URL=http://127.0.0.1:54321
# 公開してよいキー (publishable / anon)
SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。絶対に front へ渡さない・コミットしない (service_role / secret)
SUPABASE_SECRET_KEY=
# Claude API (レシート AI 判定、REQ-012。使うときだけ)
ANTHROPIC_API_KEY=
